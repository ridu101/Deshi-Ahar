rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ridu116540@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Food Items: Public View, Admin Manage
    match /foodItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
      
      function isValidFoodItem(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
               data.price is number && data.price >= 0 &&
               data.category is string &&
               data.image is string &&
               (data.description == null || data.description is string) &&
               (data.rating == null || data.rating is number);
      }
    }

    // Orders: User Create/View Own, Admin View/Update All
    match /orders/{orderId} {
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().customerId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin() && isValidOrderUpdate(incoming());
      allow delete: if isAdmin();

      function isValidOrder(data) {
        return data.customerId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.status == 'Pending' &&
               data.total is number && data.total >= 0 &&
               data.createdAt == request.time &&
               data.updatedAt == request.time;
      }

      function isValidOrderUpdate(data) {
        return data.status in ['Pending', 'Preparing', 'Out for Delivery', 'Delivered'] &&
               data.updatedAt == request.time &&
               data.diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      }
    }

    // Users: Private profile
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && !incoming().get('isAdmin', false);
    }
  }
}
